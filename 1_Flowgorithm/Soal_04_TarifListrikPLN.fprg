<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Soal_04_TarifListrikPLN"/>
        <attribute name="authors" value="Lenovo"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-09 02:47:47 PM"/>
        <attribute name="created" value="TGVub3ZvO0xBUFRPUC1SOVZKOVBFUDsyMDI2LTEwLTA5OzAyOjMwOjI0IFBNOzI5OTY="/>
        <attribute name="edited" value="TGVub3ZvO0xBUFRPUC1SOVZKOVBFUDsyMDI2LTEwLTA5OzAyOjQ3OjQ3IFBNOzI7MzExOA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="golongan" type="String" array="False" size=""/>
            <declare name="dayaVA" type="Integer" array="False" size=""/>
            <declare name="kwh, tarifBlok1, tarifBlok2, tarifBlok3, biayakwh, minCharge, totalsp, ppj, totalAkhir" type="Real" array="False" size=""/>
            <output expression="&quot;Masukkan daya listrik rumah anda (VA): &quot;" newline="True"/>
            <input variable="dayaVA"/>
            <output expression="&quot;Masukkan total pemakaian listrik (kwh): &quot;" newline="True"/>
            <input variable="biayakwh"/>
            <if expression="dayaVA &lt;= 900">
                <then>
                    <assign variable="ppj" expression="5/100"/>
                </then>
                <else>
                    <if expression="dayaVA &gt;= 1300 AND dayaVA &lt;= 2200">
                        <then>
                            <assign variable="ppj" expression="5/100"/>
                        </then>
                        <else>
                            <assign variable="ppj" expression="8/100"/>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="tarifBlok1" expression="1400"/>
            <assign variable="tarifBlok2" expression="1450"/>
            <assign variable="tarifBlok3" expression="1500"/>
        </body>
    </function>
</flowgorithm>
